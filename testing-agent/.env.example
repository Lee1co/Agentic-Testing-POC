# --- AI provider -------------------------------------------------------------
# Cursor user API key or team service-account key (Cursor Dashboard -> Integrations / API Keys).
CURSOR_API_KEY=
# cursor | external   ("external" is a prepared extension point, see src/agents/external-model-provider.ts)
AGENT_PROVIDER=cursor
# Any model id returned by `npm run agent -- models`. composer-2.5 is the SDK's documented default.
AGENT_MODEL=composer-2.5
# Hard timeout for a single agent invocation (ms).
AGENT_TIMEOUT_MS=600000
# Retries for retryable SDK startup errors (auth/network); run-level failures are never blindly retried.
AGENT_MAX_RETRIES=1
# Upper bound on AI invocations per CLI command (cost guard).
MAX_AGENT_INVOCATIONS=4

# --- Target application -------------------------------------------------------
# Application profile in app-profiles/<APP_ID>.json
APP_ID=bulletproof-react
TARGET_APP_URL=http://localhost:3000
# Browser automation is refused for any host not in this list.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Self-healing -------------------------------------------------------------
MAX_HEALING_ATTEMPTS=2

# --- Playwright ---------------------------------------------------------------
TEST_TIMEOUT_MS=60000
HEADLESS=true
